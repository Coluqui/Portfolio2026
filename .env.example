# URL pública del sitio (canonical, hreflang, sitemap). En local no hace falta.
SITE_URL=

# Formulario de contacto. Sin RESEND_API_KEY el endpoint funciona en modo local:
# no envía mails, loguea el mensaje en la consola y responde 200.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Secreto para firmar el token anti-spam (cualquier texto largo y aleatorio).
# Obligatorio en producción; en local, si falta, se genera uno por proceso.
CONTACT_FORM_SECRET=
