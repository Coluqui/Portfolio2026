---
// Confirmación del envío sin JS (backend.md). Las marcas de corte cierran el flujo (M38).
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import { type Lang, languages, useTranslations } from '../../i18n/utils';
import Page from '../../layouts/Page.astro';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<Page lang={lang} title={t('thanks.title')} noindex>
  <div class="container thanks">
    <div class="card">
      <span class="crop-marks" aria-hidden="true" data-crop="on">
        <i></i>
        <i></i>
        <i></i>
        <i></i>
      </span>
      <h1>
        <Icon name="check" /> {t('thanks.title')}
      </h1>
      <p>{t('thanks.body')}</p>
    </div>
    <div class="actions">
      <Button href={`/${lang}/#trabajos`} arrow="right">
        {t('thanks.work')}
      </Button>
      <Button href={`/${lang}/`} variant="secondary">
        {t('thanks.back')}
      </Button>
    </div>
  </div>
</Page>

<style>
  .thanks {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
    padding-block: var(--space-section);
  }

  .card {
    position: relative;
    display: grid;
    gap: var(--space-3);
    max-inline-size: var(--measure);
    padding: var(--space-7);
    background-color: var(--color-success-bg);
  }

  h1 {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    color: var(--color-success);
    font-size: var(--text-h2);
    line-height: var(--leading-h2);
    letter-spacing: var(--tracking-h2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
