---
// Home provisoria (Fase 1): verifica layout, idioma, tema y fuentes.
// La home real (hero, mosaico y secciones 01–05) se arma en la Fase 4.
import LangSwitch from '../../components/LangSwitch.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import Base from '../../layouts/Base.astro';
import { type Lang, languages, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<Base lang={lang}>
  <header class="container header">
    <span class="label">{t('home.name')}</span>
    <div class="header__tools">
      <LangSwitch lang={lang} />
      <ThemeToggle lang={lang} />
    </div>
  </header>
  <main id="main" class="container main">
    <h1>{t('home.name')}</h1>
    <p class="role">{t('meta.role')}</p>
    <p class="status label">{t('home.status')}</p>
  </main>
  <footer class="container footer">
    <p class="label">{t('footer.location')}</p>
  </footer>
</Base>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-block-size: var(--nav-height);
    border-block-end: var(--border-hairline);
  }

  .header__tools {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .main {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-section);
  }

  h1 {
    font-size: var(--text-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .role {
    font-size: var(--text-lead);
    line-height: var(--leading-lead);
    letter-spacing: var(--tracking-lead);
    color: var(--color-text-secondary);
  }

  .status {
    color: var(--color-text-secondary);
  }

  .footer {
    padding-block: var(--space-6);
    border-block-start: var(--border-hairline);
    color: var(--color-text-secondary);
  }
</style>
