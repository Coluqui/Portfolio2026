---
// Home: hero · Trabajé con · 01 Trabajos · 02 Qué hago · 03 Herramientas e IA ·
// 04 Sobre mí · 05 Contacto.
import About from '../../components/About.astro';
import ClientsStrip from '../../components/ClientsStrip.astro';
import ContactSection from '../../components/ContactSection.astro';
import Hero from '../../components/Hero.astro';
import Services from '../../components/Services.astro';
import Tools from '../../components/Tools.astro';
import WorkByCompany from '../../components/WorkByCompany.astro';
import Page from '../../layouts/Page.astro';
import { type Lang, languages } from '../../i18n/utils';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<Page lang={lang}>
  <Hero lang={lang} />
  <ClientsStrip lang={lang} />
  <WorkByCompany lang={lang} />
  <Services lang={lang} />
  <Tools lang={lang} />
  <About lang={lang} />
  <ContactSection lang={lang} />
</Page>
