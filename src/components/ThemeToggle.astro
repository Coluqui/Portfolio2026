---
// Toggle de modo claro/oscuro (M23). Interruptor con estado anunciado (role="switch" +
// aria-checked). Pulgar con --ease-spring; el ícono gira 180°. El cambio de colores es
// un fundido cruzado con View Transitions (src/scripts/theme.ts).
import Icon from './Icon.astro';
import { type Lang, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** Muestra el texto "Modo oscuro" al lado (menú mobile). En la nav queda solo para lectores. */
  showLabel?: boolean;
}

const { lang, showLabel = false } = Astro.props;
const t = useTranslations(lang);
---

<button
  class="theme-toggle"
  type="button"
  role="switch"
  aria-checked="false"
  data-theme-toggle
  data-show-label={showLabel ? '' : undefined}
>
  <span class="track" aria-hidden="true">
    <span class="thumb">
      <Icon name="theme" class="theme-toggle__icon" />
    </span>
  </span>
  <span class:list={['text', { 'visually-hidden': !showLabel }]}>{t('theme.toggle')}</span>
</button>

<style>
  .theme-toggle {
    --track-inline: var(--space-7);
    --track-block: var(--space-5);
    --thumb: var(--space-4);
    --track-pad: var(--space-1);

    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-inline-size: var(--target-min);
    min-block-size: var(--target-min);
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--weight-mono);
    letter-spacing: var(--tracking-label);
  }

  /* El borde va como outline para que no reste espacio interior al recorrido del pulgar */
  .track {
    display: grid;
    flex: none;
    align-items: center;
    inline-size: var(--track-inline);
    block-size: var(--track-block);
    padding-inline: var(--track-pad);
    outline: var(--border-control);
    outline-offset: 0;
    border-radius: var(--radius-xs);
  }

  .thumb {
    display: grid;
    place-items: center;
    inline-size: var(--thumb);
    block-size: var(--thumb);
    font-size: var(--thumb);
    transition: transform var(--duration-base) var(--ease-spring);
  }

  :global(.theme-toggle__icon) {
    transition: transform var(--duration-base) var(--ease-in-out);
  }

  .theme-toggle[aria-checked='true'] .thumb {
    transform: translateX(calc(var(--track-inline) - var(--thumb) - 2 * var(--track-pad)));
  }

  .theme-toggle[aria-checked='true'] :global(.theme-toggle__icon) {
    transform: rotate(180deg);
  }

  @media (hover: hover) and (pointer: fine) {
    .theme-toggle:hover .track {
      outline-color: var(--color-text-primary);
    }
  }

  /* M23 reducido: cambio instantáneo */
  @media (prefers-reduced-motion: reduce) {
    .thumb,
    :global(.theme-toggle__icon) {
      transition: none;
    }
  }
</style>

<script>
  import { initThemeToggle } from '../scripts/theme';

  document.addEventListener('astro:page-load', initThemeToggle);
</script>
