---
// Cambio de idioma (M24). Links a la misma página en el otro idioma con `lang`/`hreflang`;
// el subrayado viaja de ES a EN al tocar. La preferencia se guarda en una cookie (la lee `/`)
// y se conserva la sección (hash).
import { type Lang, languages, localizePath, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<nav class="lang-switch" aria-label={t('lang.label')} data-lang-switch data-active={lang}>
  <ul role="list">
    {languages.map((l) => (
      <li>
        <a
          href={localizePath(Astro.url.pathname, l)}
          hreflang={l}
          lang={l}
          aria-current={l === lang ? 'page' : undefined}
          data-lang-link={l}
        >
          <span aria-hidden="true">{t(`lang.short.${l}`)}</span>
          <span class="visually-hidden">{t(`lang.${l}`)}</span>
        </a>
      </li>
    ))}
  </ul>
  <span class="indicator" aria-hidden="true"></span>
</nav>

<style>
  .lang-switch {
    position: relative;
  }

  ul {
    display: flex;
    gap: var(--target-gap);
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-grid;
    place-items: center;
    min-inline-size: var(--target-min);
    min-block-size: var(--target-min);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--weight-mono);
    letter-spacing: var(--tracking-label);
    text-decoration: none;
  }

  a[aria-current='page'] {
    color: var(--color-text-primary);
  }

  @media (hover: hover) and (pointer: fine) {
    a:hover {
      color: var(--color-text-primary);
    }
  }

  /* Subrayado: un solo elemento que se traslada (M24, 300 ms, in-out) */
  .indicator {
    position: absolute;
    inset-block-end: var(--space-2);
    inset-inline-start: calc((var(--target-min) - var(--space-4)) / 2);
    inline-size: var(--space-4);
    block-size: var(--focus-ring-width);
    background-color: var(--color-accent);
    transition: transform var(--duration-base) var(--ease-in-out);
  }

  .lang-switch[data-active='en'] .indicator {
    transform: translateX(calc(var(--target-min) + var(--target-gap)));
  }
</style>

<script>
  import { initLangSwitch } from '../scripts/lang';

  document.addEventListener('astro:page-load', initLangSwitch);
</script>
