---
// Hero: nombre, puesto, presentación, especialidades y datos rápidos. Sin imagen (D9): el
// nombre ocupa todo el ancho y debajo van, en dos columnas desde 1280 px, la presentación
// y la ficha de datos con los botones. Las piezas viven en 01 Trabajos.
// M26: sin animación de entrada.
import Button from './Button.astro';
import CvButton from './CvButton.astro';
import { type Lang, useDictionary, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const hero = useDictionary(lang).home.hero;
---

<section class="hero container" aria-labelledby="hero-title">
  <header class="head">
    <p class="status label">
      <span class="status__dot" aria-hidden="true"></span>
      {hero.availability}
    </p>
    <p class="eyebrow label">{hero.eyebrow}</p>
    <h1 id="hero-title">{t('home.name')}</h1>
    <p class="role">{t('meta.role')}</p>
  </header>

  <div class="about">
    <p class="bio">{hero.bio}</p>
    <ul class="tags" role="list" aria-label={hero.expertiseLabel}>
      {hero.expertise.map((tag) => (
        <li class="label">{tag}</li>
      ))}
    </ul>
  </div>

  <div class="details">
    <dl class="facts" aria-label={hero.factsLabel}>
      {hero.facts.map((fact) => (
        <div>
          <dt class="label">{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))}
    </dl>
    <div class="actions">
      <Button href={`/${lang}/#trabajos`} arrow="down">
        {hero.ctaWork}
      </Button>
      <CvButton lang={lang} size="full" />
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-areas: 'head' 'about' 'details';
    gap: var(--space-7) var(--grid-gutter);
    padding-block: var(--space-7) var(--space-section);

    @media (min-width: 80rem) {
      grid-template-columns: 7fr 5fr;
      grid-template-areas: 'head head' 'about details';
      column-gap: var(--space-9);
      padding-block-start: var(--space-8);
    }
  }

  /* Encabezado: el nombre a todo el ancho, cerrado por el filete de 3 px */
  .head {
    grid-area: head;
    display: grid;
    gap: var(--space-4);
    padding-block-end: var(--space-6);
    border-block-end: var(--border-rule);
  }

  .eyebrow {
    color: var(--color-text-secondary);
  }

  /* Disponibilidad: lo primero que busca un recruiter */
  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    justify-self: start;
    padding: var(--space-1) var(--space-3);
    border: var(--border-hairline);
    border-color: var(--color-accent);
    border-radius: var(--radius-xs);
    color: var(--color-text-primary);
  }

  .status__dot {
    inline-size: var(--space-2);
    block-size: var(--space-2);
    background-color: var(--color-accent);
  }

  h1 {
    font-size: var(--text-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .role {
    color: var(--color-accent-text);
    font-size: var(--text-h3);
    font-weight: var(--weight-strong);
    line-height: var(--leading-h3);
    letter-spacing: var(--tracking-h3);
  }

  .about {
    grid-area: about;
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .bio {
    max-inline-size: var(--measure);
    font-size: var(--text-lead);
    line-height: var(--leading-lead);
    letter-spacing: var(--tracking-lead);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: var(--space-1) var(--space-2);
    border: var(--border-hairline);
    border-radius: var(--radius-xs);
    color: var(--color-text-secondary);
  }

  .details {
    grid-area: details;
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .facts {
    display: grid;
    gap: var(--space-3) var(--space-5);

    @media (min-width: 48rem) {
      grid-template-columns: max-content 1fr;
    }
  }

  /* Las filas comparten la columna de etiquetas (subgrid): se alinea a la más larga */
  .facts div {
    display: grid;
    grid-column: 1 / -1;
    gap: var(--space-1) var(--space-5);
    padding-block-end: var(--space-3);
    border-block-end: var(--border-hairline);

    @media (min-width: 48rem) {
      grid-template-columns: subgrid;
      align-items: baseline;
    }
  }

  .facts dt {
    color: var(--color-text-secondary);
  }

  .facts dd {
    margin: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
