---
// Hero: nombre, puesto, presentación, especialidades, datos rápidos y foto.
// Sin mosaico de piezas (pedido de Franco, 21 nov; ver decisiones D9): las piezas viven en
// 01 Trabajos. La foto es provisoria hasta definir un arreglo gráfico o ilustración.
// M26: sin animación de entrada.
import { Picture } from 'astro:assets';
import portrait from '../assets/franco/franco-colucci-retrato.png';
import Button from './Button.astro';
import CvButton from './CvButton.astro';
import { type Lang, useDictionary, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const hero = useDictionary(lang).home.hero;
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="intro">
    <p class="eyebrow label">{hero.eyebrow}</p>
    <h1 id="hero-title">{t('home.name')}</h1>
    <p class="role">{t('meta.role')}</p>
    <p class="bio">{hero.bio}</p>
    <ul class="tags" role="list" aria-label={hero.expertiseLabel}>
      {hero.expertise.map((tag) => (
        <li class="label">{tag}</li>
      ))}
    </ul>
  </div>

  <figure class="photo">
    <Picture
      src={portrait}
      alt={hero.photoAlt}
      formats={['avif', 'webp']}
      widths={[320, 480, 600]}
      sizes="(min-width: 80rem) 30vw, (min-width: 48rem) 40vw, 80vw"
      loading="eager"
    />
  </figure>

  <div class="details">
    <dl class="facts" aria-label={hero.factsLabel}>
      {hero.facts.map((fact) => (
        <div>
          <dt class="label">{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))}
    </dl>
    <div class="actions">
      <Button href={`/${lang}/#trabajos`} arrow="down">
        {hero.ctaWork}
      </Button>
      <CvButton lang={lang} size="full" />
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-areas: 'intro' 'details' 'photo';
    gap: var(--space-6) var(--grid-gutter);
    padding-block: var(--space-6) var(--space-section);

    @media (min-width: 48rem) {
      grid-template-columns: 3fr 2fr;
      grid-template-areas: 'intro photo' 'details photo';
      align-items: start;
    }

    @media (min-width: 80rem) {
      grid-template-columns: 7fr 5fr;
      padding-block-start: var(--space-7);
    }
  }

  .intro {
    grid-area: intro;
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .eyebrow {
    color: var(--color-text-secondary);
  }

  h1 {
    font-size: var(--text-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .role {
    font-size: var(--text-h3);
    font-weight: var(--weight-strong);
    line-height: var(--leading-h3);
    letter-spacing: var(--tracking-h3);
  }

  .bio {
    max-inline-size: var(--measure);
    font-size: var(--text-lead);
    line-height: var(--leading-lead);
    letter-spacing: var(--tracking-lead);
    color: var(--color-text-secondary);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: var(--space-1) var(--space-2);
    border: var(--border-hairline);
    border-radius: var(--radius-xs);
    color: var(--color-text-secondary);
  }

  /* Foto provisoria (D9): retrato 4:5 sobre el escenario */
  .photo {
    grid-area: photo;
    aspect-ratio: var(--ratio-carousel);
    overflow: hidden;
    background-color: var(--color-stage);
  }

  .photo :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: top;
  }

  .details {
    grid-area: details;
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .facts {
    display: grid;
    gap: var(--space-3) var(--space-5);

    @media (min-width: 48rem) {
      grid-template-columns: max-content 1fr;
    }
  }

  /* Las filas comparten la columna de etiquetas (subgrid): se alinea a la más larga */
  .facts div {
    display: grid;
    grid-column: 1 / -1;
    gap: var(--space-1) var(--space-5);
    padding-block-end: var(--space-3);
    border-block-end: var(--border-hairline);

    @media (min-width: 48rem) {
      grid-template-columns: subgrid;
      align-items: baseline;
    }
  }

  .facts dt {
    color: var(--color-text-secondary);
  }

  .facts dd {
    margin: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
